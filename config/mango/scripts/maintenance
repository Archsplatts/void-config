#!/bin/bash

set -euo pipefail 

VERT='\033[0;32m'
JAUNE='\033[1;33m'
NC='\033[0m'

echo -e "${VERT}=== Maintenance Archsplatts ===${NC}"
echo

echo -e "${JAUNE}>>> Mise à jour de xbps...${NC}"
sudo xbps-install -Syu xbps
echo

echo -e "${JAUNE}>>> Recherche de mises à jour Void...${NC}"
sudo xbps-install -Syu || echo "Aucun paquet à mettre à jour."
echo

echo -e "${JAUNE}>>> Recherche de mises à jour flatpak...${NC}"
flatpak update || echo "Aucun flatpak à mettre à jour."
echo

echo -e "${JAUNE}>>> Nettoyage...${NC}"
sudo xbps-remove -oO
sudo vkpurge rm all
echo

echo -e "${VERT}=== Maintenance terminée ===${NC}"
