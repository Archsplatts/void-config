{
	"include": ["$HOME/.config/mango/waybar/modules/*.jsonc"],

	"layer": "top",
	"position": "bottom",
	"height": 32,
	"spacing": 0,
	"reload_style_on_change": true,
	
	"modules-left": ["mango/workspaces"],

	"modules-center": ["mango/window"],
	
	"modules-right": [
		"custom/updates",
		"tray",
		"pulseaudio",
		"network",
		"clock" ]
}
