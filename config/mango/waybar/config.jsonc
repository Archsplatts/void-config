{
	"include": ["$HOME/.config/mango/waybar/modules/*.jsonc"],

	"layer": "top",
	"position": "top",
	"height": 32,
	"spacing": 0,
	"reload_style_on_change": true,
	
	"modules-left": [
	"custom/menu", 
	"ext/workspaces"],

	"modules-center": [
		"clock",
		"custom/updates"],
	
	"modules-right": [
		"wlr/taskbar",
		"tray",
		"pulseaudio",
		"network"]
}
