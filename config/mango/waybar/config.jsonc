{
	"include": ["$HOME/.config/mango/waybar/modules/*.jsonc"],

	"layer": "top",
	"position": "top",
	"height": 30,
	"spacing": 0,
	"reload_style_on_change": true,
	
	"modules-left": ["ext/workspaces"],

	"modules-center": [
		"custom/updates",
		"custom/circle3",
		"disk#ssd",		
		"custom/circle4",
		"custom/menu",
		"custom/circle5",
		"clock",
		"custom/circle6",
		"pulseaudio"],
	
	"modules-right": [
		"wlr/taskbar",
		"tray",
 		"network"]
}
