{
   	"custom/updates": {
    	"format": "{0}{icon}",
    	"return-type": "json",
    	"interval": 21600,
		"icon": true,
    	"signal": 1, 
    	"format-icons": {
        	"has-updates": "\u00A0󰊠\u00A0\u00A0",
        	"updated": "\u00A0󰊠\u00A0\u00A0"
    },
    	"exec": "/home/USER/.config/mango/waybar/scripts/checkupdates",
    	"on-click": "/home/USER/.config/waybar/scripts/checkupdates; pkill -SIGRTMIN+1 waybar"
	}
}	
