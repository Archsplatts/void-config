* {
    active: #98C379FF;
    background: rgba(30, 30, 46, 0.90);
    background-alt: #313244;
    foreground: #c6d0f5;
    selected: #94e2d5;
    urgent: #E06B74FF;
}

* {
    font: "UbuntuNerd Font 15";
}

configuration {
    display-drun: " Apps";
    drun-display-format: "{name}";
    hover-select: true;
    me-accept-entry: "MousePrimary";
    me-select-entry: "";
    modi: "drun";
    show-icons: true;
}

element {
    background-color: transparent;
    border: 0px solid;
    border-color: @selected;
    border-radius: 8px;
    cursor: pointer;
    margin: 0px;
    orientation: vertical;
    padding: 30px 10px;
    spacing: 20px;
    text-color: @foreground;
}

element normal.normal {
    background-color: transparent;
    text-color: @foreground;
}

element selected.normal {
    background-color: @background-alt;
    text-color: @foreground;
}

element-icon {
    background-color: transparent;
    cursor: inherit;
    padding: 0px 0px 0px 0px;
    size: 420px;
    text-color: inherit;
}

element-text {
    background-color: transparent;
    cursor: inherit;
    highlight: inherit;
    horizontal-align: 0.5;
    text-color: inherit;
    vertical-align: 0.5;
}

entry {
    background-color: #1e1e2e;
    border-radius: 8px;
    cursor: text;
    expand: false;
    padding: 15px 20px;
    placeholder: "Search...";
    placeholder-color: inherit;
    text-color: @foreground;
    width: 350px;
}

error-message {
    background-color: @background;
    border: 0px solid;
    border-color: @selected;
    border-radius: 0px;
    padding: 50px;
    text-color: @foreground;
}

inputbar {
    background-color: transparent;
    border: 0px;
    border-color: @selected;
    border-radius: 0px;
    children: [ "prompt", "entry" ];
    margin: 0px;
    padding: 0px;
    spacing: 20px;
    text-color: @foreground;
}

listview {
    background-color: transparent;
    border: 0px solid;
    border-color: @selected;
    border-radius: 0px;
    columns: 4;
    cycle: true;
    cursor: "default";
    dynamic: true;
    fixed-columns: true;
    fixed-height: true;
    layout: vertical;
    lines: 1;
    margin: 0px;
    padding: 0px;
    reverse: false;
    scrollbar: false;
    spacing: 0px;
    text-color: @foreground;
}

mainbox {
    background-color: transparent;
    border: 0px solid;
    border-color: @selected;
    border-radius: 0px 0px 0px 0px;
    children: [ "inputbar", "listview" ];
    margin: 0px;
    padding: 42px;
    spacing: 20px;
}

prompt {
    background-color: @selected;
    border-radius: 8px;
    padding: 15px;
    text-color: @background;
}

scrollbar {
    background-color: @background-alt;
    border-radius: 0px;
    handle-color: @selected;
    handle-width: 5px;
}

textbox {
    background-color: transparent;
    highlight: none;
    horizontal-align: 0.0;
    text-color: @foreground;
    vertical-align: 0.5;
}

textbox-prompt-colon {
    background-color: inherit;
    expand: false;
    str: "::";
    text-color: inherit;
}

window {
    anchor: center;
    background-color: @background;
    border: 3px;
    border-color: @selected;
    border-radius: 8px;
    cursor: "default";
    fullscreen: false;
    location: center;
    margin: 0px;
    padding: 0px;
    transparency: "real";
    width: 80%;
    x-offset: 0px;
    y-offset: 0px;
}   
