@import "themes/catppuccin-default"

configuration {
    font: "UbuntuNerd Font 15";
    hover-select: true;
    me-accept-entry: "MousePrimary";
    me-select-entry: "";
}

element {
    background-color: inherit;
    padding: 10;
    spacing: 10;
    text-color: @text;
}

element alternate normal {
    background-color: transparent;
    text-color: @text;
}

element normal normal {
    background-color: transparent;
    text-color: @text;
}

element selected normal, element selected active {
    background-color: inherit;
    border-radius: 8px;
    text-color: @teal;
}

element-icon {
    size: 30px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

inputbar {
    enabled: false;
}

listview {
    border: 0;
    columns: 1;
    flow: vertical;
    lines: 8;
    scrollbar: false;
    spacing: 14px;
}

mainbox {
    background-color: transparent;
    border-color: @selected;
    border-radius: 0px;
    children: [ "listview" ];
    enabled: true;
    margin: 0px;
    padding: 14px;
    spacing: 14px;
}

window {
    background-color: rgba(30,30,46,0.90);
    border: 3px;
    border-color: @teal;
    border-radius: 8px;
    icon-theme: "Papirus";
    modi: "drun";
    padding: 14;
    show-icons: true;
    transparency: "real";
    width: 20%;
}   
