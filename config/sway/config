set $mod Mod4
set $term foot
set $menu rofi -modes "drun,run" -show drun -config ~/.config/rofi/applications-menu.rasi
set $filemanager thunar
set $web brave-origin
set $texteditor geany

# Output configuration
output HDMI-A-1 resolution 1920x1080 position 0,0
output * bg ~/Images/Wallpapers/sunken-tower.png fill

# Input configuration
input type:keyboard { 
	xkb_layout "fr" 
	xkb_numlock enabled 
}

# Bar

bar { 
 	position top
 	status_command while date +'%d %B %Y - %H:%M'; do sleep 1; done
 	height 30
 	font pango:Ubuntu Mono Nerd Font Medium 12
 	separator_symbol " "
 	tray_padding 8

 	colors {
 		statusline #cdd6f4
 		background #1e1e2e
 		separator #313244
 		focused_workspace #94e2d5 #1e1e2e #cdd6f4
 		active_workspace #94e2d5 #1e1e2e #cdd6f4
 		inactive_workspace # a6adc8 #1e1e2e #313244
 		urgent_workspace #f38ba8 #1e1e2e #cdd6f4
 		binding_mode #f38ba8 #1e1e2e #cdd6f4
 	}
}

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
