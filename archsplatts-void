echo -e "${JAUNE}Bienvenue dans le script de configuration Archsplatts Void Linux!${NC}\n"

if [ -t 0 ]; then
    read -p "Appuyez sur Entrée pour continuer... "
fi   

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[1/6] Mise à jour du système${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

sudo xbps-install -u xbps
sudo xbps-install -Syu

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[2/6] Outils de terminal & shell${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

TERM_PKGS=(
	"bat"
	"btop"
	"calcurse"
	"dust"
	"eza"
	"fastfetch"
	"micro"
	"starship"
	"termdown"
	"trash-cli"
	"unzip"
	"yazi"
	"zip"
	"zsh"
	"zsh-autosuggestions"
	"zsh-syntax-highlighting"
)

sudo xbps-install -Sy "${TERM_PKGS[@]}"

sudo chsh -s /bin/zsh $USER

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[3/6] Installation des applications${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

APPS_PKGS=(
	"evince"
	"galculator"
	"gnome-disk-utility"
	"impression"
	"lollypop"
	"mpv"
	"rofi"
	"qbittorrent" 
	"thunderbird"
	"timeshift"
	"tuxguitar"
	"xarchiver"
	"xfce4-whiskermenu-plugin"
)

sudo xbps-install -Sy "${APPS_PKGS[@]}"

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
