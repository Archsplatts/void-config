#!/bin/bash
set -euo pipefail

ARCH="${1:-x86_64}"
DEST="$HOME/Téléchargements"
PAGE="https://www.reaper.fm/download.php"

VERSION=$(curl -fsSL "$PAGE" | grep -oP "class='hdrbottom'>Version \K[0-9]+\.[0-9]+")

if [[ -z "$VERSION" ]]; then
    echo "Erreur : version non détectée." >&2
    exit 1
fi

MAJOR="${VERSION%%.*}"
MINOR="${VERSION##*.}"
URL="https://www.reaper.fm/files/${MAJOR}.x/reaper${MAJOR}${MINOR}_linux_${ARCH}.tar.xz"
FILE="$DEST/reaper${MAJOR}${MINOR}_linux_${ARCH}.tar.xz"

mkdir -p "$DEST"
echo "Version : ${VERSION}"
echo "URL     : ${URL}"
curl -fsSL --retry 3 --retry-delay 2 -o "$FILE" "$URL"

echo "✓ ${FILE} ($(du -h "$FILE" | cut -f1))"   
