#!/bin/bash

set -euo pipefail 

VERT='\033[0;32m'
JAUNE='\033[1;33m'
NC='\033[0m'

echo -e "${VERT}=== Script d'activation de Steam ===${NC}"
echo

echo -e "${JAUNE}>>> Installation des flatpak...${NC}"
flatpak install runtime/com.valvesoftware.Steam.Utility.MangoHud/x86_64/stable com.valvesoftware.Steam.CompatibilityTool.Proton-GE com.valvesoftware.Steam
flatpak override --user --env=MANGOHUD=1 com.valvesoftware.Steam
echo

echo -e "${VERT}=== Steam activé ===${NC}"
echo
