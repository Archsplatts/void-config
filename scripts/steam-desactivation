#!/bin/bash

set -euo pipefail 

VERT='\033[0;32m'
JAUNE='\033[1;33m'
NC='\033[0m'

echo -e "${VERT}=== Script de désactivation de Steam ===${NC}"
echo

echo -e "${JAUNE}>>> Désinstallation des flatpak...${NC}"
flatpak uninstall --delete-data runtime/com.valvesoftware.Steam.Utility.MangoHud/x86_64/stable com.valvesoftware.Steam.CompatibilityTool.Proton-GE com.valvesoftware.Steam
flatpak uninstall --unused
echo

echo -e "${VERT}=== Steam desactivé ===${NC}"
echo
