## Lact daemon

# Installer
sudo xbps-install -S lact

# Créer le service
sudo mkdir -p /etc/sv/lact
sudo micro /etc/sv/lact/run

Insérer ceci :
#!/bin/sh
exec 2>&1
exec chpst -u root lact daemon

# Le rendre exécutable
sudo chmod +x /etc/sv/lact/run

# Activer le service au démarrage
sudo ln -s /etc/sv/lact /var/service/

# Vérifier
sudo sv status /var/service/lact
